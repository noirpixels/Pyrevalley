static func rows_of(name: String, mirrored: bool) -> Array:

	var rows: Array = TEMPLATES[name]["rows"]
	if not mirrored:
		return rows.duplicate()
	var out = []
	for row in rows:
		var flipped = ""
		for i in range(row.length() - 1, -1, -1):
			flipped += row[i]
		out.append(flipped)
	return out


static func doors_of(name: String, mirrored: bool) -> String:

	var doors: String = TEMPLATES[name]["doors"]
	if mirrored:
		doors = doors.replace("L", "l").replace("R", "L").replace("l", "R")
	return doors
